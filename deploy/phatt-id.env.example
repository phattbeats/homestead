# Copy next to your real .env; values here are public (no secrets).

# ── PHATT ID (Authentik on vps1), PHA-4973 (2026-11-08) ─────────────────────────
# Provider "homestead" in https://auth.phatt.vip. Verify tokens against the JWKS (RS256, kid rotates by
# re-fetch), check iss + aud. The client secret is NOT here: it lives only in the host's real .env,
# handed over from vps1 /root/pha4973/secrets/homestead.oidc.env (root only).
OIDC_ISSUER=https://auth.phatt.vip/application/o/homestead/
OIDC_JWKS_URL=https://auth.phatt.vip/application/o/homestead/jwks/
OIDC_CLIENT_ID=homestead
# OIDC_CLIENT_SECRET=   (never commit)
OIDC_REDIRECT_URI=https://life.phatt.vip/api/me/identities/link/callback
OIDC_SCOPES="openid profile email phatt_type"
